# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# CLI Proxy API Configuration
CLI_PROXY_URL=http://localhost:8317/v1
CLI_PROXY_KEY=your-custom-api-key-here
CLI_PROXY_MODEL=gemini-3.5-flash-low

# Bot Behavior Configuration
# Customize the system instructions for the AI model
SYSTEM_PROMPT="You are a helpful, friendly, and intelligent AI assistant. Keep your responses concise and engaging."

# Security: Comma-separated list of allowed Telegram usernames or IDs
# If empty, the bot is public. (e.g., ALLOWED_USERS=my_username,another_username,12345678)
ALLOWED_USERS=

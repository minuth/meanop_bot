TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
ANTIGRAVITY_REFRESH_TOKEN=your-antigravity-oauth-refresh-token-here
BOSS=your_telegram_username
MODEL=gemini-3.5-flash-low
